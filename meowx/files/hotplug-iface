#!/bin/sh
# WAN 重新拨号后出口 IP 可能变了：登录了主控账户、服务在跑时补报一次客户端 IP 白名单
[ "$ACTION" = "ifup" ] || exit 0
case "$INTERFACE" in
	wan|wan6|wwan*) ;;
	*) exit 0 ;;
esac
[ -f /etc/meowx/panel.json ] || exit 0
pgrep -x meowx-core >/dev/null 2>&1 || exit 0
(sleep 5; /usr/bin/meowx-core panel report >/dev/null 2>&1) &
