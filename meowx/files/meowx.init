#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG="/usr/bin/meowx-core"

. "$IPKG_INSTROOT/etc/meowx/scripts/include.sh"

extra_command 'update_subscription' 'Update subscription by section id'
extra_command 'refresh_subscription' 'Update subscription by section id, reload if it is the active profile'
extra_command 'switch_profile' 'Switch to profile (file:<name> / subscription:<section>) and reload'
extra_command 'auto_update' 'Refresh the active subscription if it is older than the auto update interval'
extra_command 'panel_cron' 'Set the firewall whitelist report cron (panel account / po0)'
extra_command 'panel_report' 'Report the firewall whitelist now, reload if the po0 list changed'
extra_command 'clear_logs' 'Clear logs if size exceeds the limit'
extra_command 'ghproxy_cron' 'Re-test GitHub mirrors (auto mode), reload if the selected one became unreachable'

boot_func() {
	# prepare files
	prepare_files
	# load config
	config_load meowx
	# start delay
	local enabled start_delay
	config_get_bool enabled "config" "enabled" 0
	config_get start_delay "config" "start_delay" 0
	if [ "$enabled" = 1 ] && [ "$start_delay" -gt 0 ]; then
		log "App" "Start after $start_delay seconds."
		sleep "$start_delay"
	fi
	# start
	start
}

boot() {
	boot_func < /dev/null > /dev/null 2>&1 &
}

start_service() {
	# prepare files
	prepare_files
	# load config
	config_load meowx
	# check if enabled
	local enabled
	config_get_bool enabled "config" "enabled" 0
	if [ "$enabled" = 0 ]; then
		clear_error
		log "App" "Disabled."
		log "App" "Exit."
		return
	fi
	# start
	log "App" "Enabled."
	log "App" "Start."
	# check if executable
	if [ ! -x $PROG ]; then
		log "App" "Core is not executable."
		set_error "Core is not executable."
		log "App" "Exit."
		return
	fi
	# get config
	## app config
	local scheduled_restart scheduled_restart_cron test_profile
	config_get_bool scheduled_restart "config" "scheduled_restart" 0
	config_get scheduled_restart_cron "config" "scheduled_restart_cron"
	config_get_bool test_profile "config" "test_profile" 0
	## procd config
	### general
	local fast_reload
	config_get_bool fast_reload "procd" "fast_reload" 0
	### rlimit
	local rlimit_nproc_soft rlimit_nproc_hard rlimit_address_space_soft rlimit_address_space_hard rlimit_data_soft rlimit_data_hard rlimit_stack_soft rlimit_stack_hard rlimit_nofile_soft rlimit_nofile_hard
	config_get rlimit_nproc_soft "procd" "rlimit_nproc_soft" "$(ulimit -Su)"
	config_get rlimit_nproc_hard "procd" "rlimit_nproc_hard" "$(ulimit -Hu)"
	config_get rlimit_address_space_soft "procd" "rlimit_address_space_soft"
	config_get rlimit_address_space_hard "procd" "rlimit_address_space_hard"
	config_get rlimit_data_soft "procd" "rlimit_data_soft"
	config_get rlimit_data_hard "procd" "rlimit_data_hard"
	config_get rlimit_stack_soft "procd" "rlimit_stack_soft"
	config_get rlimit_stack_hard "procd" "rlimit_stack_hard"
	config_get rlimit_nofile_soft "procd" "rlimit_nofile_soft" "$(ulimit -Sn)"
	config_get rlimit_nofile_hard "procd" "rlimit_nofile_hard" "$(ulimit -Hn)"
	### environment variable
	local env_go_max_procs env_go_mem_limit env_safe_paths env_disable_loopback_detector env_disable_quic_go_gso env_disable_quic_go_ecn env_skip_system_ipv6_check
	config_get env_go_max_procs "procd" "env_go_max_procs"
	config_get env_go_mem_limit "procd" "env_go_mem_limit"
	config_get env_safe_paths "procd" "env_safe_paths"
	config_get_bool env_disable_loopback_detector "procd" "env_disable_loopback_detector" 0
	config_get_bool env_disable_quic_go_gso "procd" "env_disable_quic_go_gso" 0
	config_get_bool env_disable_quic_go_ecn "procd" "env_disable_quic_go_ecn" 0
	config_get_bool env_skip_system_ipv6_check "procd" "env_skip_system_ipv6_check" 0
	## log config
	local log_scheduled_clear log_scheduled_clear_cron
	config_get_bool log_scheduled_clear "log" "scheduled_clear" 0
	config_get log_scheduled_clear_cron "log" "scheduled_clear_cron"
	# profile
	if [ -n "$PREPARED_PROFILE" ]; then
		# reload 已经生成并测试过
		install_file "$PREPARED_PROFILE" "$RUN_PROFILE_PATH"
		PREPARED_PROFILE=""
	else
		local candidate_path; candidate_path=$(mktemp "$TEMP_DIR/config.XXXXXX")
		if ! build_profile "$candidate_path" "$test_profile"; then
			rm -f "$candidate_path"
			set_error "$BUILD_ERROR"
			log "App" "Exit."
			return
		fi
		install_file "$candidate_path" "$RUN_PROFILE_PATH"
	fi
	# start core
	clear_error
	log "Core" "Start."
	procd_open_instance meowx

	procd_set_param command /bin/sh -c "$PROG -d $RUN_DIR >> $CORE_LOG_PATH 2>&1"
	procd_set_param file "$RUN_PROFILE_PATH"
	if [ "$fast_reload" = 1 ]; then
		procd_set_param reload_signal HUP
	fi
	procd_set_param pidfile "$PID_FILE_PATH"
	procd_set_param respawn

	procd_append_param limits nproc="${rlimit_nproc_soft} ${rlimit_nproc_hard}"
	procd_append_param limits as="${rlimit_address_space_soft:-unlimited} ${rlimit_address_space_hard:-unlimited}"
	procd_append_param limits data="${rlimit_data_soft:-unlimited} ${rlimit_data_hard:-unlimited}"
	procd_append_param limits stack="${rlimit_stack_soft:-unlimited} ${rlimit_stack_hard:-unlimited}"
	procd_append_param limits nofile="${rlimit_nofile_soft} ${rlimit_nofile_hard}"

	procd_append_param env GOMAXPROCS="$env_go_max_procs"
	procd_append_param env GOMEMLIMIT="$env_go_mem_limit"

	procd_append_param env SAFE_PATHS="$env_safe_paths"
	procd_append_param env DISABLE_LOOPBACK_DETECTOR="$env_disable_loopback_detector"
	procd_append_param env QUIC_GO_DISABLE_GSO="$env_disable_quic_go_gso"
	procd_append_param env QUIC_GO_DISABLE_ECN="$env_disable_quic_go_ecn"
	procd_append_param env SKIP_SYSTEM_IPV6_CHECK="$env_skip_system_ipv6_check"

	procd_close_instance
	# cron
	## clear cron
	if grep -q "#meowx" "/etc/crontabs/root"; then
		log "App" "Clear cron."
		sed -i "/#meowx/d" "/etc/crontabs/root" > /dev/null 2>&1
	fi
	## add restart cron if needed
	if [ "$scheduled_restart" = 1 ] && [ -n "$scheduled_restart_cron" ]; then
		log "App" "Set scheduled restart."
		echo "$scheduled_restart_cron /etc/init.d/meowx restart #meowx scheduled restart" >> "/etc/crontabs/root"
	fi
	## add subscription auto update cron（与客户端一致：当前订阅超过间隔才刷新，每小时看一次）
	local auto_update_interval; config_get auto_update_interval "config" "auto_update_interval" "24"
	if [ "$auto_update_interval" -gt 0 ] 2>/dev/null; then
		log "App" "Set subscription auto update cron."
		echo "17 * * * * /etc/init.d/meowx auto_update #meowx subscription auto update" >> "/etc/crontabs/root"
	fi
	## 客户端 IP 白名单（主控账户 + po0）上报的定时任务，启动时先报一次
	set_panel_cron
	(/etc/init.d/meowx panel_report >/dev/null 2>&1 &)
	## GitHub 加速选「自动选最快」时每天重测一次（启动时缓存还新就不测）
	if [ "$(uci -q get meowx.ghproxy.mode)" = "auto" ]; then
		log "App" "Set GitHub mirror test cron."
		echo "41 4 * * * /etc/init.d/meowx ghproxy_cron #meowx ghproxy" >> "/etc/crontabs/root"
	fi
	## add log scheduled clear cron if needed
	if [ "$log_scheduled_clear" = 1 ] && [ -n "$log_scheduled_clear_cron" ]; then
		log "App" "Set log scheduled clear."
		echo "$log_scheduled_clear_cron /etc/init.d/meowx clear_logs #meowx log scheduled clear" >> "/etc/crontabs/root"
	fi
	# set started flag
	touch "$STARTED_FLAG_PATH"
}

# 把 $1 原子地装到 $2（先拷到同目录的临时文件再 mv：/var/run 与 /etc 不在同一个文件系统，直接 mv 不是原子的），然后删掉 $1
install_file() {
	cp -f "$1" "$2.tmp" && mv -f "$2.tmp" "$2"
	local result=$?
	rm -f "$1"
	return $result
}

# 按当前选择的配置（上传的文件 / 订阅）生成完整的运行配置写到 $1：取配置 → 混入 → 检查 →（$2 = 1 时）用内核测试。
# 不碰正在运行的 config.yaml；失败返回 1，原因放在 BUILD_ERROR
build_profile() {
	local profile_path; profile_path="$1"
	local test; test="$2"
	BUILD_ERROR=""
	config_load meowx
	local profile; config_get profile "config" "profile"
	case "$profile" in
		file:*)
			local profile_name; profile_name="${profile#file:}"
			local profile_file; profile_file="$PROFILES_DIR/$profile_name"
			log "Profile" "Use file: $profile_name."
			if [ ! -f "$profile_file" ]; then
				log "Profile" "File not found."
				BUILD_ERROR="Profile file not found: $profile_name."
				return 1
			fi
			cp -f "$profile_file" "$profile_path"
			;;
		subscription:*)
			local subscription_section; subscription_section="${profile#subscription:}"
			# 在用的订阅 section 不存在（被删掉，或旧版匿名 section 调整顺序后 ID 变了）：明确报错，不拿空名字往下走
			if ! subscription_exists "$subscription_section"; then
				log "Profile" "Subscription not found: $subscription_section. Please choose a subscription again."
				BUILD_ERROR="Subscription not found: $subscription_section. Please choose a subscription again."
				return 1
			fi
			local subscription_name subscription_prefer
			config_get subscription_name "$subscription_section" "name"
			config_get subscription_prefer "$subscription_section" "prefer" "remote"
			log "Profile" "Use subscription: ${subscription_name:-$subscription_section}."
			local subscription_file; subscription_file="$SUBSCRIPTIONS_DIR/$subscription_section.yaml"
			# 本次刚下载并测试过（刷新订阅后紧接着重载）就不再下载、不再测试
			if [ "$SUBSCRIPTION_UPDATED" = "$subscription_section" ] && [ -f "$subscription_file" ]; then
				test=0
			elif [ "$subscription_prefer" = "remote" ] || [ ! -f "$subscription_file" ]; then
				if update_subscription "$subscription_section"; then
					test=0
				elif [ -f "$subscription_file" ]; then
					log "Profile" "Subscription update failed, use the last downloaded copy."
				fi
				config_load meowx
				config_get subscription_name "$subscription_section" "name"
			fi
			if [ ! -f "$subscription_file" ]; then
				local subscription_error; config_get subscription_error "$subscription_section" "error"
				log "Profile" "Subscription file not found."
				BUILD_ERROR="Subscription ${subscription_name:-$subscription_section} has no local copy and the update failed${subscription_error:+: $subscription_error}."
				return 1
			fi
			cp -f "$subscription_file" "$profile_path"
			;;
		*)
			log "Profile" "No profile/subscription selected."
			BUILD_ERROR="No profile/subscription selected."
			return 1
			;;
	esac
	mixin_profile "$profile_path"
	check_profile "$profile_path" || return 1
	# test profile
	if [ "$test" = 1 ]; then
		log "Profile" "Testing..."
		if test_profile_file "$profile_path"; then
			log "Profile" "Test passed."
		else
			log "Profile" "Test failed: $TEST_ERROR"
			log "Profile" "Please check the core log to find out the problem."
			BUILD_ERROR="Profile test failed: $TEST_ERROR"
			return 1
		fi
	fi
	return 0
}

# 混入：按插件设置改写 $1（启动生成运行配置、更新订阅时校验，走的是同一份）
mixin_profile() {
	local profile_path; profile_path="$1"
	local core_only; config_get_bool core_only "config" "core_only" 0
	## mixin config
	### overwrite
	local overwrite_authentication overwrite_tun_dns_hijack overwrite_fake_ip_filter overwrite_hosts overwrite_dns_nameserver overwrite_dns_nameserver_policy overwrite_sniffer_sniff overwrite_sniffer_force_domain_name overwrite_sniffer_ignore_domain_name
	config_get_bool overwrite_authentication "mixin" "authentication" 0
	config_get_bool overwrite_tun_dns_hijack "mixin" "tun_dns_hijack" 0
	config_get_bool overwrite_fake_ip_filter "mixin" "fake_ip_filter" 0
	config_get_bool overwrite_hosts "mixin" "hosts" 0
	config_get_bool overwrite_dns_nameserver "mixin" "dns_nameserver" 0
	config_get_bool overwrite_dns_nameserver_policy "mixin" "dns_nameserver_policy" 0
	config_get_bool overwrite_sniffer_force_domain_name "mixin" "sniffer_force_domain_name" 0
	config_get_bool overwrite_sniffer_ignore_domain_name "mixin" "sniffer_ignore_domain_name" 0
	config_get_bool overwrite_sniffer_sniff "mixin" "sniffer_sniff" 0
	### mixin file content
	local mixin_file_content
	config_get_bool mixin_file_content "mixin" "mixin_file_content" 0
	## proxy config
	local proxy_enabled; config_get_bool proxy_enabled "proxy" "enabled" 0
	# mixin
	if [ "$core_only" = 0 ]; then
		log "Mixin" "Mixin config."
		if [ "$overwrite_authentication" = 1 ]; then
			yq -M -i 'del(.authentication)' "$profile_path"
		fi
		if [ "$overwrite_tun_dns_hijack" = 1 ]; then
			yq -M -i 'del(.tun.dns-hijack)' "$profile_path"
		fi
		if [ "$overwrite_fake_ip_filter" = 1 ]; then
			yq -M -i 'del(.dns.fake-ip-filter)' "$profile_path"
		fi
		if [ "$overwrite_hosts" = 1 ]; then
			yq -M -i 'del(.hosts)' "$profile_path"
		fi
		if [ "$overwrite_dns_nameserver" = 1 ]; then
			yq -M -i 'del(.dns.default-nameserver) | del(.dns.proxy-server-nameserver) | del(.dns.direct-nameserver) | del(.dns.nameserver) | del(.dns.fallback) ' "$profile_path"
		fi
		if [ "$overwrite_dns_nameserver_policy" = 1 ]; then
			yq -M -i 'del(.dns.nameserver-policy)' "$profile_path"
		fi
		if [ "$overwrite_sniffer_force_domain_name" = 1 ]; then
			yq -M -i 'del(.sniffer.force-domain)' "$profile_path"
		fi
		if [ "$overwrite_sniffer_ignore_domain_name" = 1 ]; then
			yq -M -i 'del(.sniffer.skip-domain)' "$profile_path"
		fi
		if [ "$overwrite_sniffer_sniff" = 1 ]; then
			yq -M -i 'del(.sniffer.sniff)' "$profile_path"
		fi
		if [ "$mixin_file_content" = 0 ]; then
			ucode -S "$MIXIN_UC" | yq -M -p json -o yaml | yq -M -i eval-all '... comments="" | . as $item ireduce ({}; . * $item ) | .proxies = .meowx-proxies + .proxies | del(.meowx-proxies) | .proxy-groups = .meowx-proxy-groups + .proxy-groups | del(.meowx-proxy-groups) | .rules = .meowx-rules + .rules | del(.meowx-rules) | explode(.)' "$profile_path" -
		elif [ "$mixin_file_content" = 1 ]; then
			ucode -S "$MIXIN_UC" | yq -M -p json -o yaml | yq -M -i eval-all '... comments="" | . as $item ireduce ({}; . * $item ) | .proxies = .meowx-proxies + .proxies | del(.meowx-proxies) | .proxy-groups = .meowx-proxy-groups + .proxy-groups | del(.meowx-proxy-groups) | .rules = .meowx-rules + .rules | del(.meowx-rules) | explode(.)' "$profile_path" "$MIXIN_FILE_PATH" -
		fi
		if [ "$proxy_enabled" = 1 ]; then
			if yq -M -e 'has("tun")' "$profile_path" > /dev/null 2>&1; then
				yq -M -i '(.tun) |= (.auto-route = false | .auto-redirect = false | .auto-detect-interface = false | .disable-icmp-forwarding = true)' "$profile_path"
			fi
			if yq -M -e 'has("listeners")' "$profile_path" > /dev/null 2>&1; then
				yq -M -i '(.listeners[] | select(.type == "tun")) |= (.auto-route = false | .auto-redirect = false | .auto-detect-interface = false | .disable-icmp-forwarding = true)' "$profile_path"
			fi
		fi
	else
		# 仅核心：订阅原样用，只写入「混入配置 → 外部控制配置」里的外部控制端口 / 密钥 / Web 面板，
		# 否则订阅里多半没有 external-controller，「打开面板」「更新 Web 面板」和插件取状态都用不了
		log "Mixin" "Core only, set external controller."
		ucode -l uci -e '
			const c = uci.cursor();
			const out = {};
			const keys = {
				"external-controller": "api_listen",
				"external-controller-tls": "api_tls_listen",
				"secret": "api_secret",
				"external-ui": "ui_path",
				"external-ui-name": "ui_name",
				"external-ui-url": "ui_url"
			};
			// 混入配置里没填的也写成 null，盖掉订阅自带的（如 external-ui-name: metacubexd 而面板装在 ui/ 下，打开就 404）
			for (let k, o in keys) {
				const v = c.get("meowx", "mixin", o);
				out[k] = (v != null && v != "") ? v : null;
			}
			printf("%J\n", out);
		' | yq -M -p json -o yaml | yq -M -i eval-all '. as $item ireduce ({}; . * $item )' "$profile_path" -
	fi
	# Web 面板放在 external-ui 目录下的哪个子目录，以混入配置为准：没填就去掉订阅自带的 external-ui-name
	# （订阅常带 metacubexd，「更新 Web 面板」却装在 ui/ 下，打开面板就 404；混入配置的空值在 trim_all 里被丢掉，盖不住它）
	if [ -z "$(uci -q get meowx.mixin.ui_name)" ]; then
		yq -M -i 'del(.external-ui-name)' "$profile_path"
	fi
	ghproxy_apply "$profile_path"
}

# GitHub 加速（插件配置 → GitHub 加速）：把 $1 里面板、Geo 数据、规则集指向 GitHub 的下载地址换成加速地址。
# 只改运行配置（与混入同一步），不改订阅原文件；proxy-providers 与订阅地址不碰（可能带令牌，经第三方加速站会泄漏）。
# 「仅核心」开着时同样生效：这是下载用的设置，不是混入
ghproxy_apply() {
	local profile_path; profile_path="$1"
	local mode; mode=$(uci -q get meowx.ghproxy.mode)
	[ -z "$mode" ] || [ "$mode" = "off" ] && return 0
	local patch
	patch=$(yq -M -p yaml -o json 'explode(.) | {"external-ui": .["external-ui"], "external-ui-url": .["external-ui-url"], "geox-url": .["geox-url"], "rule-providers": .["rule-providers"]}' "$profile_path" 2>/dev/null | ucode -S "$GHPROXY_CLI" apply)
	if [ -z "$patch" ] || [ "$patch" = "{}" ] || [ "$patch" = "{ }" ]; then
		return 0
	fi
	echo "$patch" | yq -M -p json -o yaml | yq -M -i eval-all '. as $item ireduce ({}; . * $item )' "$profile_path" -
}

# 检查 $1 里有没有透明代理需要的 DNS / 入站；不通过返回 1，原因放在 BUILD_ERROR
check_profile() {
	local profile_path; profile_path="$1"
	local core_only; config_get_bool core_only "config" "core_only" 0
	## core config
	local redirect_listener_name tproxy_listener_name tun_listener_name
	config_get redirect_listener_name "core" "redirect_listener_name"
	config_get tproxy_listener_name "core" "tproxy_listener_name"
	config_get tun_listener_name "core" "tun_listener_name"
	## proxy config
	local proxy_enabled ipv4_dns_hijack ipv6_dns_hijack tcp_mode udp_mode
	config_get_bool proxy_enabled "proxy" "enabled" 0
	config_get_bool ipv4_dns_hijack "proxy" "ipv4_dns_hijack" 0
	config_get_bool ipv6_dns_hijack "proxy" "ipv6_dns_hijack" 0
	config_get tcp_mode "proxy" "tcp_mode"
	config_get udp_mode "proxy" "udp_mode"
	# check profile
	if [ "$core_only" = 0 ] && [ "$proxy_enabled" = 1 ]; then
		log "Profile" "Checking..."
		if [ "$ipv4_dns_hijack" = 1 ] || [ "$ipv6_dns_hijack" = 1 ]; then
			if yq -M -e '(has("dns") and (.dns | .enable) and (.dns | has("listen"))) | not' "$profile_path" > /dev/null 2>&1; then
				log "Profile" "Check failed."
				log "Profile" "DNS should be enabled and listen should be defined."
				BUILD_ERROR="Profile check failed: DNS should be enabled and listen should be defined."
				return 1
			fi
		fi
		if [ "$tcp_mode" = "redirect" ]; then
			if yq -M -e "(has(\"redir-port\") or (has(\"listeners\") and .listeners | any_c(.name == \"$redirect_listener_name\" and .type == \"redir\"))) | not" "$profile_path" > /dev/null 2>&1; then
				log "Profile" "Check failed."
				log "Profile" "Redirect Port/Listener should be defined."
				BUILD_ERROR="Profile check failed: Redirect Port/Listener should be defined."
				return 1
			fi
		fi
		if [ "$tcp_mode" = "tproxy" ] || [ "$udp_mode" = "tproxy" ]; then
			if yq -M -e "(has(\"tproxy-port\") or (has(\"listeners\") and .listeners | any_c(.name == \"$tproxy_listener_name\" and .type == \"tproxy\"))) | not" "$profile_path" > /dev/null 2>&1; then
				log "Profile" "Check failed."
				log "Profile" "TPROXY Port/Listener should be defined."
				BUILD_ERROR="Profile check failed: TPROXY Port/Listener should be defined."
				return 1
			fi
		fi
		if [ "$tcp_mode" = "tun" ] || [ "$udp_mode" = "tun" ]; then
			if yq -M -e "(has(\"tun\") and (.tun | .enable) and (.tun | has(\"device\"))) or (has(\"listeners\") and .listeners | any_c(.name == \"$tun_listener_name\" and .type == \"tun\" and has(\"device\")))) | not" "$profile_path" > /dev/null 2>&1; then
				log "Profile" "Check failed."
				log "Profile" "TUN should be defined."
				BUILD_ERROR="Profile check failed: TUN should be defined."
				return 1
			fi
		fi
		log "Profile" "Check passed."
	fi
	return 0
}

# 用内核测试 $1（-f 指定文件），在独立的临时目录里测，不碰正在运行的 run 目录与 config.yaml。
# 地理数据从 run 目录软链过去（不然每测一次内核都要重新下载）；run 目录里还没有、测试时下载下来的挪回 run 目录给启动用。
# 不通过返回 1，内核报的第一条错误放在 TEST_ERROR
test_profile_file() {
	local profile_path; profile_path="$1"
	TEST_ERROR=""
	local env_go_max_procs env_go_mem_limit env_safe_paths env_disable_loopback_detector env_disable_quic_go_gso env_disable_quic_go_ecn env_skip_system_ipv6_check
	config_get env_go_max_procs "procd" "env_go_max_procs"
	config_get env_go_mem_limit "procd" "env_go_mem_limit"
	config_get env_safe_paths "procd" "env_safe_paths"
	config_get_bool env_disable_loopback_detector "procd" "env_disable_loopback_detector" 0
	config_get_bool env_disable_quic_go_gso "procd" "env_disable_quic_go_gso" 0
	config_get_bool env_disable_quic_go_ecn "procd" "env_disable_quic_go_ecn" 0
	config_get_bool env_skip_system_ipv6_check "procd" "env_skip_system_ipv6_check" 0
	local test_dir; test_dir=$(mktemp -d "$TEMP_DIR/test.XXXXXX")
	local file
	for file in "$RUN_DIR"/*.mmdb "$RUN_DIR"/*.metadb "$RUN_DIR"/*.dat; do
		[ -f "$file" ] && ln -s "$file" "$test_dir/${file##*/}"
	done
	local output result
	# 配置里写在 run 目录下的绝对路径（如混入的规则集文件）照样要能用：run 目录加进 SAFE_PATHS
	output=$(env \
		GOMAXPROCS="$env_go_max_procs" \
		GOMEMLIMIT="$env_go_mem_limit" \
		SAFE_PATHS="$RUN_DIR${env_safe_paths:+:$env_safe_paths}" \
		DISABLE_LOOPBACK_DETECTOR="$env_disable_loopback_detector" \
		QUIC_GO_DISABLE_GSO="$env_disable_quic_go_gso" \
		QUIC_GO_DISABLE_ECN="$env_disable_quic_go_ecn" \
		SKIP_SYSTEM_IPV6_CHECK="$env_skip_system_ipv6_check" \
		$PROG -t -d "$test_dir" -f "$profile_path" 2>&1)
	result=$?
	echo "$output" >> "$CORE_LOG_PATH"
	for file in "$test_dir"/*.mmdb "$test_dir"/*.metadb "$test_dir"/*.dat; do
		[ -f "$file" ] && [ ! -L "$file" ] && [ ! -e "$RUN_DIR/${file##*/}" ] && mv -f "$file" "$RUN_DIR/"
	done
	rm -rf "$test_dir"
	if [ "$result" != 0 ]; then
		TEST_ERROR=$(echo "$output" | grep -m 1 -E 'level=(error|fatal)' | sed -n 's/.*msg="\(.*\)".*/\1/p')
		[ -z "$TEST_ERROR" ] && TEST_ERROR=$(echo "$output" | grep -v -E 'level=(info|warning|debug)' | head -n 1)
		[ -z "$TEST_ERROR" ] && TEST_ERROR="core exited with code $result"
		return 1
	fi
	return 0
}

service_started() {
	# check if started
	if [ ! -f "$STARTED_FLAG_PATH" ]; then
		return
	fi
	# load config
	config_load meowx
	# check if proxy enabled
	local proxy_enabled
	config_get_bool proxy_enabled "proxy" "enabled" 0
	if [ "$proxy_enabled" = 0 ]; then
		log "Proxy" "Disabled."
		return
	fi
	# get config
	## app config
	local core_only
	config_get_bool core_only "config" "core_only" 0
	## core
	local tun_listener_name
	config_get tun_listener_name "core" "tun_listener_name"
	## proxy config
	### general
	local tcp_mode udp_mode ipv4_proxy ipv6_proxy tun_timeout tun_interval
	config_get tcp_mode "proxy" "tcp_mode"
	config_get udp_mode "proxy" "udp_mode"
	config_get_bool ipv4_proxy "proxy" "ipv4_proxy" 0
	config_get_bool ipv6_proxy "proxy" "ipv6_proxy" 0
	config_get tun_timeout "proxy" "tun_timeout" 30
	config_get tun_interval "proxy" "tun_interval" 1
	## routing config
	local tproxy_fw_mark tproxy_fw_mask tun_fw_mark tun_fw_mask tproxy_rule_pref tun_rule_pref tproxy_route_table tun_route_table cgroup_id cgroup_name dummy_device
	config_get tproxy_fw_mark "routing" "tproxy_fw_mark" "0x80"
	config_get tproxy_fw_mask "routing" "tproxy_fw_mask" "0xFF"
	config_get tun_fw_mark "routing" "tun_fw_mark" "0x81"
	config_get tun_fw_mask "routing" "tun_fw_mask" "0xFF"
	config_get tproxy_rule_pref "routing" "tproxy_rule_pref" "1024"
	config_get tun_rule_pref "routing" "tun_rule_pref" "1025"
	config_get tproxy_route_table "routing" "tproxy_route_table" "80"
	config_get tun_route_table "routing" "tun_route_table" "81"
	config_get cgroup_id "routing" "cgroup_id" "0x12061206"
	config_get cgroup_name "routing" "cgroup_name" "meowx"
	config_get dummy_device "routing" "dummy_device" "meowx-dummy"
	# prepare config
	local tproxy_enable; tproxy_enable=0
	if [ "$tcp_mode" = "tproxy" ] || [ "$udp_mode" = "tproxy" ]; then
		tproxy_enable=1
	fi
	local tun_enable; tun_enable=0
	if [ "$tcp_mode" = "tun" ] || [ "$udp_mode" = "tun" ]; then
		tun_enable=1
	fi
	local dns_mode; dns_mode=$(yq -M '.dns.enhanced-mode // ""' "$RUN_PROFILE_PATH")
	local fake_ip6_range; fake_ip6_range=$(yq -M '.dns.fake-ip-range6 // ""' "$RUN_PROFILE_PATH")
	local tun_device; tun_device=$(yq -M "(.tun | select(.enable) | .device) // (.listeners[] | select(.name == \"$tun_listener_name\" and .type == \"tun\") | .device)" "$RUN_PROFILE_PATH")
	if [ "$core_only" = 0 ]; then
		# proxy
		log "Proxy" "Enabled."
		# wait for tun device online
		if [ "$tun_enable" = 1 ]; then
			log "Proxy" "Waiting for tun device online within $tun_timeout seconds..."
			while [ "$tun_timeout" -gt 0 ]; do
				if ip -j link show dev "$tun_device" 2>/dev/null | jsonfilter -q -e "@[@['flags'][@='UP']]" > /dev/null 2>&1; then
					log "Proxy" "TUN device is online."
					break
				fi
				tun_timeout=$((tun_timeout - tun_interval))
				sleep "$tun_interval"
			done
			if [ "$tun_timeout" -le 0 ]; then
				log "Proxy" "Timeout, TUN device is not online."
				log "App" "Exit."
				return
			fi
		fi
		# fix compatible with dockerd
		## cgroupfs-mount
		### when cgroupfs-mount is installed, cgroupv1 will mounted instead of cgroupv2, we need to create cgroup manually
		if mount | grep -q -w "^cgroup"; then
			mkdir -p "/sys/fs/cgroup/net_cls/$cgroup_name"
			echo "$cgroup_id" > "/sys/fs/cgroup/net_cls/$cgroup_name/net_cls.classid"
			cat "$PID_FILE_PATH" > "/sys/fs/cgroup/net_cls/$cgroup_name/cgroup.procs"
		fi
		## kmod-br-netfilter
		### when kmod-br-netfilter is loaded, bridge-nf-call-iptables and bridge-nf-call-ip6tables are set to 1, we need to set them to 0 if tproxy is enabled
		if [ "$tproxy_enable" = 1 ] && (lsmod | grep -q br_netfilter); then
			if [ "$ipv4_proxy" = 1 ]; then
				local bridge_nf_call_iptables; bridge_nf_call_iptables=$(sysctl -e -n net.bridge.bridge-nf-call-iptables)
				if [ "$bridge_nf_call_iptables" = 1 ]; then
					touch "$BRIDGE_NF_CALL_IPTABLES_FLAG_PATH"
					sysctl -q -w net.bridge.bridge-nf-call-iptables=0
				fi
			fi
			if [ "$ipv6_proxy" = 1 ]; then
				local bridge_nf_call_ip6tables; bridge_nf_call_ip6tables=$(sysctl -e -n net.bridge.bridge-nf-call-ip6tables)
				if [ "$bridge_nf_call_ip6tables" = 1 ]; then
					touch "$BRIDGE_NF_CALL_IP6TABLES_FLAG_PATH"
					sysctl -q -w net.bridge.bridge-nf-call-ip6tables=0
				fi
			fi
		fi
		# ip route and rule
		if [ "$tproxy_enable" = 1 ]; then
			if [ "$ipv4_proxy" = 1 ]; then
				ip -4 route add local default dev lo table "$tproxy_route_table"
				ip -4 rule add pref "$tproxy_rule_pref" fwmark "$tproxy_fw_mark/$tproxy_fw_mask" table "$tproxy_route_table"
			fi
			if [ "$ipv6_proxy" = 1 ]; then
				ip -6 route add local default dev lo table "$tproxy_route_table"
				ip -6 rule add pref "$tproxy_rule_pref" fwmark "$tproxy_fw_mark/$tproxy_fw_mask" table "$tproxy_route_table"
			fi
		fi
		if [ "$tun_enable" = 1 ]; then
			if [ "$ipv4_proxy" = 1 ]; then
				ip -4 route add unicast default dev "$tun_device" table "$tun_route_table"
				ip -4 rule add pref "$tun_rule_pref" fwmark "$tun_fw_mark/$tun_fw_mask" table "$tun_route_table"
			fi
			if [ "$ipv6_proxy" = 1 ]; then
				ip -6 route add unicast default dev "$tun_device" table "$tun_route_table"
				ip -6 rule add pref "$tun_rule_pref" fwmark "$tun_fw_mark/$tun_fw_mask" table "$tun_route_table"
			fi
			$FIREWALL_INCLUDE_SH
		fi
		if [ "$dns_mode" = "fake-ip" ] && [ -n "$fake_ip6_range" ]; then
			ip link add "$dummy_device" type dummy
			ip link set dev "$dummy_device" up
			ip -6 route add "$fake_ip6_range" dev "$dummy_device"
		fi
		# hijack
		utpl -S "$HIJACK_UT" | nft -f -
		# check hijack
		if nft list tables | grep -q meowx; then
			log "Proxy" "Hijack successful."
		else
			log "Proxy" "Hijack failed."
			log "App" "Exit."
		fi
	fi
}

service_stopped() {
	cleanup
}

reload_service() {
	prepare_files
	config_load meowx
	local enabled; config_get_bool enabled "config" "enabled" 0
	if [ "$enabled" = 1 ] && [ -x $PROG ]; then
		# 先生成并测试新配置，通过才拆掉旧的、换上新的；不通过就保留现在运行的不动
		# （以前先 cleanup 再生成，生成或测试失败时代理已经拆了，路由器就断网了）
		log "App" "Reload."
		local candidate_path; candidate_path=$(mktemp "$TEMP_DIR/config.XXXXXX")
		if ! build_profile "$candidate_path" 1; then
			rm -f "$candidate_path"
			log "App" "Reload failed, keep the running config: $BUILD_ERROR"
			set_error "$BUILD_ERROR"
			return 1
		fi
		PREPARED_PROFILE="$candidate_path"
	fi
	# 重载不是停止：不按「停止时清空日志」清掉，刚才生成 / 测试新配置的日志要留着
	cleanup keep_logs
	start
}

service_triggers() {
	procd_add_reload_trigger "meowx"
}

cleanup() {
	# load config
	config_load meowx
	# get config
	## log config
	local log_clear_at_stop
	config_get_bool log_clear_at_stop "log" "clear_at_stop" 0
	## routing config
	local tproxy_route_table tun_route_table dummy_device
	config_get tproxy_route_table "routing" "tproxy_route_table" "80"
	config_get tun_route_table "routing" "tun_route_table" "81"
	config_get dummy_device "routing" "dummy_device" "meowx-dummy"
	# clear logs if needed
	if [  "$log_clear_at_stop" = 1 ] && [ "$1" != "keep_logs" ]; then
		echo -n > "$APP_LOG_PATH"
		echo -n > "$CORE_LOG_PATH"
		log "Log" "Logs are cleared due to clear at stop is enabled."
	fi
	# delete routing policy
	ip -4 rule del table "$tproxy_route_table" > /dev/null 2>&1
	ip -4 rule del table "$tun_route_table" > /dev/null 2>&1
	ip -6 rule del table "$tproxy_route_table" > /dev/null 2>&1
	ip -6 rule del table "$tun_route_table" > /dev/null 2>&1
	# delete routing table
	ip -4 route flush table "$tproxy_route_table" > /dev/null 2>&1
	ip -4 route flush table "$tun_route_table" > /dev/null 2>&1
	ip -6 route flush table "$tproxy_route_table" > /dev/null 2>&1
	ip -6 route flush table "$tun_route_table" > /dev/null 2>&1
	# delete dummy device
	ip -6 link del "$dummy_device" > /dev/null 2>&1
	# delete hijack
	nft delete table inet meowx > /dev/null 2>&1
	local handles handle
	handles=$(nft --json list table inet fw4 | jsonfilter -q -e "@['nftables'][*]['rule']" | jsonfilter -q -a -e "@[@['chain']='input']" | jsonfilter -q -a -e "@[@['comment']='meowx']" | jsonfilter -q -a -e "@[*]['handle']")
	for handle in $handles; do
		nft delete rule inet fw4 input handle "$handle"
	done
	handles=$(nft --json list table inet fw4 | jsonfilter -q -e "@['nftables'][*]['rule']" | jsonfilter -q -a -e "@[@['chain']='forward']" | jsonfilter -q -a -e "@[@['comment']='meowx']" | jsonfilter -q -a -e "@[*]['handle']")
	for handle in $handles; do
		nft delete rule inet fw4 forward handle "$handle"
	done
	# delete started flag
	rm "$STARTED_FLAG_PATH" > /dev/null 2>&1
	# revert fix compatible with dockerd
	## kmod-br-netfilter
	if rm "$BRIDGE_NF_CALL_IPTABLES_FLAG_PATH" > /dev/null 2>&1; then
		sysctl -q -w net.bridge.bridge-nf-call-iptables=1
	fi
	if rm "$BRIDGE_NF_CALL_IP6TABLES_FLAG_PATH" > /dev/null 2>&1; then
		sysctl -q -w net.bridge.bridge-nf-call-ip6tables=1
	fi
	# delete cron
	if grep -q "#meowx" "/etc/crontabs/root"; then
		sed -i "/#meowx/d" "/etc/crontabs/root" > /dev/null 2>&1
	fi
}

clear_logs() {
	# load config
	config_load meowx
	# get config
	## log config
	local log_scheduled_clear_size_limit log_scheduled_clear_size_limit_unit
	config_get log_scheduled_clear_size_limit "log" "scheduled_clear_size_limit" 1
	config_get log_scheduled_clear_size_limit_unit "log" "scheduled_clear_size_limit_unit" "MB"
	# prepare config
	local log_scheduled_clear_size_limit_in_bytes; log_scheduled_clear_size_limit_in_bytes=0
	case "$log_scheduled_clear_size_limit_unit" in
		B)
			log_scheduled_clear_size_limit_in_bytes=$((log_scheduled_clear_size_limit))
		;;
		KB)
			log_scheduled_clear_size_limit_in_bytes=$((log_scheduled_clear_size_limit * 1024))
		;;
		MB)
			log_scheduled_clear_size_limit_in_bytes=$((log_scheduled_clear_size_limit * 1024 * 1024))
		;;
		GB)
			log_scheduled_clear_size_limit_in_bytes=$((log_scheduled_clear_size_limit * 1024 * 1024 * 1024))
		;;
	esac
	# clear logs
	if [ -f "$APP_LOG_PATH" ] && [ "$(wc -c < "$APP_LOG_PATH")" -ge "$log_scheduled_clear_size_limit_in_bytes" ]; then
		echo -n > "$APP_LOG_PATH"
		log "Log" "App log is cleared due to scheduled clear and exceeding size limits."
	fi
	if [ -f "$CORE_LOG_PATH" ] && [ "$(wc -c < "$CORE_LOG_PATH")" -ge "$log_scheduled_clear_size_limit_in_bytes" ]; then
		echo -n > "$CORE_LOG_PATH"
		log "Log" "Core log is cleared due to scheduled clear and exceeding size limits."
	fi
}

# 「meowx」或留空 = 官方客户端 UA：mihomo/1.19.0 MeowX/<内核版本> (OpenWrt)，与 iOS / Android 同一格式。
# 开头的 mihomo/1.19.0 是主控与机场判断「给完整 clash YAML」用的，别动；MeowX/<版本> 让主控下发只有官方内核才支持的节点。
official_user_agent() {
	if [ -n "$1" ] && [ "$1" != "meowx" ]; then
		echo "$1"
		return
	fi
	local version; version=$($PROG -v 2>/dev/null | head -n 1 | cut -d ' ' -f 3 | sed 's/^meowx-//')
	echo "mihomo/1.19.0 MeowX/${version:-0} (OpenWrt)"
}

# 更新订阅。返回 0 成功（缓存已替换）/ 1 失败（旧缓存保留，原因写在 UCI 的 error_type / error）/ 3 等别的任务更新超时
update_subscription() {
	local subscription_section; subscription_section="$1"
	if ! subscription_exists "$subscription_section"; then
		log "Profile" "Subscription not found: $subscription_section."
		return 1
	fi
	# 服务还没启动过时这些目录都不存在（启动时才建），在界面里先添加、刷新订阅会写不进去
	mkdir -p "$LOG_DIR" "$TEMP_DIR" "$SUBSCRIPTIONS_DIR"
	# 下载 → 校验 → 替换缓存整个过程按订阅加锁：自动更新、手动刷新、启动时的更新不会同时改同一份缓存。
	# （24.10 的 procd.sh 被 source 时就拿了服务锁，经 init 脚本的调用本来就是串行的；这把锁不依赖它，界面也靠它判断「正在更新」）
	{
		local waited; waited=0
		while ! flock -n 9; do
			if [ "$waited" -ge 600 ]; then
				log "Profile" "Subscription $subscription_section is being updated by another task."
				return 3
			fi
			sleep 1
			waited=$((waited + 1))
		done
		update_subscription_locked "$subscription_section"
	} 9> "$TEMP_DIR/subscription.$subscription_section.lock"
}

update_subscription_locked() {
	local subscription_section; subscription_section="$1"
	# load config
	config_load meowx
	# get subscription config
	local subscription_name subscription_info_url subscription_url subscription_user_agent
	config_get subscription_name "$subscription_section" "name"
	config_get subscription_info_url "$subscription_section" "info_url"
	config_get subscription_url "$subscription_section" "url"
	config_get subscription_user_agent "$subscription_section" "user_agent"
	subscription_user_agent=$(official_user_agent "$subscription_user_agent")
	# update subscription
	log "Profile" "Update subscription: ${subscription_name:-$subscription_section}."
	# 临时文件每次都用新的（以前按 section 名固定，自动更新与手动刷新会互相覆盖）
	local subscription_info_header_tmpfile; subscription_info_header_tmpfile=$(mktemp "$TEMP_DIR/subscription.XXXXXX")
	local subscription_header_tmpfile; subscription_header_tmpfile=$(mktemp "$TEMP_DIR/subscription.XXXXXX")
	local subscription_tmpfile; subscription_tmpfile=$(mktemp "$TEMP_DIR/subscription.XXXXXX")
	local subscription_info_file
	local subscription_file; subscription_file="$SUBSCRIPTIONS_DIR/$subscription_section.yaml"
	local error_type error
	# fetch subscription info
	if [ -n "$subscription_info_url" ]; then
		log "Profile" "Fetch subscription info."
		if curl -s -f -m 120 --connect-timeout 15 --retry 3 -L -X GET -A "$subscription_user_agent" -D "$subscription_info_header_tmpfile" "$subscription_info_url" > /dev/null 2>&1; then
			if grep -q -i "subscription-userinfo:" "$subscription_info_header_tmpfile"; then
				subscription_info_file="$subscription_info_header_tmpfile"
			fi
		fi
	fi
	# download subscription
	log "Profile" "Download subscription."
	local http_code curl_result
	http_code=$(curl -s -f -m 120 --connect-timeout 15 --retry 3 -L -X GET -A "$subscription_user_agent" -D "$subscription_header_tmpfile" -o "$subscription_tmpfile" -w '%{http_code}' "$subscription_url" 2> /dev/null)
	curl_result=$?
	if [ "$curl_result" != 0 ]; then
		error_type="download"
		if [ "$curl_result" = 22 ]; then
			error="HTTP $http_code"
		else
			error="curl exit code $curl_result"
		fi
		log "Profile" "Subscription download failed: $error."
	else
		log "Profile" "Subscription download successful."
		if [ -z "$subscription_info_file" ] && grep -q -i "subscription-userinfo:" "$subscription_header_tmpfile"; then
			subscription_info_file="$subscription_header_tmpfile"
		fi
		# proxies 必须是非空列表，或 proxy-providers 是非空映射（以前只看有没有这个键，proxies: null 也能过）
		if ! yq -M -p yaml -o yaml -e '((.proxies | tag) == "!!seq" and (.proxies | length) > 0) or ((.["proxy-providers"] | tag) == "!!map" and (.["proxy-providers"] | length) > 0)' "$subscription_tmpfile" > /dev/null 2>&1; then
			error_type="invalid"
			error="no proxies or proxy-providers in it, or it is not a Clash YAML"
			log "Profile" "Subscription is not valid."
		else
			# 按真实的插件设置混入出完整配置，用内核测一遍（与启动时生成运行配置同一条路径）
			local candidate_path; candidate_path=$(mktemp "$TEMP_DIR/subscription.XXXXXX")
			cp -f "$subscription_tmpfile" "$candidate_path"
			mixin_profile "$candidate_path"
			if test_profile_file "$candidate_path"; then
				log "Profile" "Subscription is valid."
			else
				error_type="test"
				error="$TEST_ERROR"
				log "Profile" "Subscription failed the core test: $error"
			fi
			rm -f "$candidate_path"
		fi
	fi
	# check if success
	if [ -z "$error_type" ]; then
		log "Profile" "Subscription update successful."
		# 先换缓存（同目录临时文件 + mv，原子替换），再改 UCI 里的订阅信息
		install_file "$subscription_tmpfile" "$subscription_file"
		# reset subscription info
		uci_remove "meowx" "$subscription_section" "expire" > /dev/null 2>&1
		uci_remove "meowx" "$subscription_section" "upload" > /dev/null 2>&1
		uci_remove "meowx" "$subscription_section" "download" > /dev/null 2>&1
		uci_remove "meowx" "$subscription_section" "total" > /dev/null 2>&1
		uci_remove "meowx" "$subscription_section" "used" > /dev/null 2>&1
		uci_remove "meowx" "$subscription_section" "avaliable" > /dev/null 2>&1
		uci_remove "meowx" "$subscription_section" "error_type" > /dev/null 2>&1
		uci_remove "meowx" "$subscription_section" "error" > /dev/null 2>&1
		if [ -f "$subscription_info_file" ]; then
			local subscription_expire subscription_upload subscription_download subscription_total subscription_used subscription_avaliable
			subscription_expire=$(grep -i "subscription-userinfo: " "$subscription_info_file" | grep -i -o -E "expire=[[:digit:]]+" | cut -d '=' -f 2)
			subscription_upload=$(grep -i "subscription-userinfo: " "$subscription_info_file" | grep -i -o -E "upload=[[:digit:]]+" | cut -d '=' -f 2)
			subscription_download=$(grep -i "subscription-userinfo: " "$subscription_info_file" | grep -i -o -E "download=[[:digit:]]+" | cut -d '=' -f 2)
			subscription_total=$(grep -i "subscription-userinfo: " "$subscription_info_file" | grep -i -o -E "total=[[:digit:]]+" | cut -d '=' -f 2)
			if [ -n "$subscription_upload" ] && [ -n "$subscription_download" ]; then
				subscription_used=$((subscription_upload + subscription_download))
				if [ -n "$subscription_total" ]; then
					subscription_avaliable=$((subscription_total - subscription_used))
				fi
			fi
			# 原始值（界面画用量条、算到期天数用）
			uci_set "meowx" "$subscription_section" "used_bytes" "${subscription_used:-}"
			uci_set "meowx" "$subscription_section" "total_bytes" "${subscription_total:-}"
			uci_set "meowx" "$subscription_section" "expire_ts" "${subscription_expire:-}"
			# update subscription info
			if [ -n "$subscription_expire" ]; then
				uci_set "meowx" "$subscription_section" "expire" "$(date "+%Y-%m-%d %H:%M:%S" -d "@$subscription_expire")"
			fi
			if [ -n "$subscription_upload" ]; then
				uci_set "meowx" "$subscription_section" "upload" "$(format_filesize "$subscription_upload")"
			fi
			if [ -n "$subscription_download" ]; then
				uci_set "meowx" "$subscription_section" "download" "$(format_filesize "$subscription_download")"
			fi
			if [ -n "$subscription_total" ]; then
				uci_set "meowx" "$subscription_section" "total" "$(format_filesize "$subscription_total")"
			fi
			if [ -n "$subscription_used" ]; then
				uci_set "meowx" "$subscription_section" "used" "$(format_filesize "$subscription_used")"
			fi
			if [ -n "$subscription_avaliable" ]; then
				uci_set "meowx" "$subscription_section" "avaliable" "$(format_filesize "$subscription_avaliable")"
			fi
		fi
		uci_set "meowx" "$subscription_section" "update" "$(date "+%Y-%m-%d %H:%M:%S")"
		uci_set "meowx" "$subscription_section" "update_ts" "$(date +%s)"
		uci_set "meowx" "$subscription_section" "success" "1"
		# 订阅名跟着主控 / 机场给的 profile-title 走（可能是 base64:…），同客户端；建议刷新间隔记下来给界面看
		local subscription_title subscription_interval
		subscription_title=$(grep -i "^profile-title:" "$subscription_header_tmpfile" | tail -n 1 | cut -d ':' -f 2- | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
		case "$subscription_title" in
			base64:*) subscription_title=$(printf '%s' "${subscription_title#base64:}" | ucode -l fs -e 'print(b64dec(trim(fs.stdin.read("all"))) ?? "")' 2>/dev/null) ;;
		esac
		if [ -n "$subscription_title" ]; then
			uci_set "meowx" "$subscription_section" "name" "$subscription_title"
		fi
		subscription_interval=$(grep -i "^profile-update-interval:" "$subscription_header_tmpfile" | tail -n 1 | grep -o -E "[[:digit:]]+" | head -n 1)
		uci_set "meowx" "$subscription_section" "update_interval" "${subscription_interval:-}"
	else
		# 失败：旧缓存与上次的用量 / 更新时间都保留，记下失败原因给界面
		log "Profile" "Subscription update failed, keep the last downloaded copy."
		uci_set "meowx" "$subscription_section" "success" "0"
		uci_set "meowx" "$subscription_section" "error_type" "$error_type"
		uci_set "meowx" "$subscription_section" "error" "$error"
	fi
	rm -f "$subscription_info_header_tmpfile" "$subscription_header_tmpfile" "$subscription_tmpfile"
	uci_commit "meowx"
	if [ -z "$error_type" ]; then
		SUBSCRIPTION_UPDATED="$subscription_section"
		return 0
	fi
	return 1
}

# 刷新订阅；它正是当前在用的配置、服务又在跑时重载（客户端刷新当前订阅后立刻生效，同此）。
# 返回 0 已更新（在用的话也已套用）/ 1 更新失败 / 2 已更新但套用失败（运行中的保持不动，原因在 last_error）/ 3 等别的任务更新超时
refresh_subscription() {
	local subscription_section; subscription_section="$1"
	subscription_exists "$subscription_section" || return 1
	update_subscription "$subscription_section" || return $?
	config_load meowx
	local profile; config_get profile "config" "profile"
	if [ "$profile" = "subscription:$subscription_section" ] && service_running_meowx; then
		log "Profile" "Active subscription updated, reload."
		reload || return 2
	fi
	return 0
}

# 切换在用的配置（file:<文件名> / subscription:<section>）。没启用的话顺手启用，同客户端「选了订阅就连上」。
# 服务在跑时先生成并测试新配置，不能用就退回原来的选择、运行中的保持不动（返回 2，原因在 last_error）
switch_profile() {
	local profile; profile="$1"
	case "$profile" in
		file:*|subscription:*) ;;
		*) return 1 ;;
	esac
	case "$profile" in
		subscription:*)
			if ! subscription_exists "${profile#subscription:}"; then
				log "Profile" "Subscription not found: ${profile#subscription:}."
				return 1
			fi
			;;
	esac
	local previous; previous=$(uci -q get meowx.config.profile)
	uci_set "meowx" "config" "profile" "$profile"
	uci_set "meowx" "config" "enabled" "1"
	uci_commit "meowx"
	log "Profile" "Switch to: $profile."
	if service_running_meowx; then
		if ! reload; then
			uci_set "meowx" "config" "profile" "$previous"
			uci_commit "meowx"
			log "Profile" "Switch failed, keep using: $previous."
			return 2
		fi
	else
		# 订阅还没下载过（导入时下载失败等）启动时会先下载
		restart
		[ -s "$LAST_ERROR_PATH" ] && return 2
	fi
	return 0
}

# 每小时由 cron 调一次：当前订阅距上次更新超过 auto_update_interval 小时（缺省 24，0 关闭）就刷新
auto_update() {
	config_load meowx
	local profile interval last now
	config_get profile "config" "profile"
	config_get interval "config" "auto_update_interval" "24"
	case "$profile" in subscription:*) ;; *) return 0 ;; esac
	[ "$interval" -gt 0 ] 2>/dev/null || return 0
	if ! subscription_exists "${profile#subscription:}"; then
		log "Profile" "Auto update skipped, the active subscription is not found: ${profile#subscription:}."
		return 1
	fi
	config_get last "${profile#subscription:}" "update_ts" "0"
	now=$(date +%s)
	if [ $((now - last)) -ge $((interval * 3600)) ]; then
		log "Profile" "Auto update active subscription."
		refresh_subscription "${profile#subscription:}"
	fi
}

service_running_meowx() {
	ubus call service list '{"name":"meowx"}' 2>/dev/null | grep -q '"running": true'
}

# po0 实际上报的地址（每行一个）：mixin 按它们给每台 po0 加直连规则，所以列表变了要重载
po0_report_urls() {
	[ -f "/etc/meowx/po0.json" ] && jsonfilter -i "/etc/meowx/po0.json" -e '@.report_urls[*]' 2>/dev/null
}

# 白名单上报间隔同客户端 FirewallReporter：有 po0 时每 10 分钟（一台 po0 只有 5 个名额、全体用户共用，按最久没报的先挤掉），
# 只有主控账户时每小时；两样都没有就不上报。只在服务跑着时挂（服务停了，路由器也就不经节点出去）
set_panel_cron() {
	sed -i "/#meowx panel report/d" "/etc/crontabs/root" > /dev/null 2>&1
	local schedule
	if [ -n "$(po0_report_urls)" ]; then
		schedule="*/10 * * * *"
	elif [ -f "/etc/meowx/panel.json" ]; then
		schedule="23 * * * *"
	else
		return
	fi
	log "App" "Set firewall whitelist report cron."
	echo "$schedule /etc/init.d/meowx panel_report >/dev/null 2>&1 #meowx panel report" >> "/etc/crontabs/root"
}

# 登录 / 退出 / 改 po0 后由 LuCI 调：服务跑着才挂定时任务
panel_cron() {
	if /etc/init.d/meowx running; then
		set_panel_cron
	else
		sed -i "/#meowx panel report/d" "/etc/crontabs/root" > /dev/null 2>&1
	fi
}

panel_report() {
	local before after
	before="$(po0_report_urls)"
	/usr/bin/meowx-core panel report > /dev/null 2>&1
	after="$(po0_report_urls)"
	# 主控下发的 po0 列表 6 小时重取一次（report 里顺带做），变了就重载让直连规则跟上
	if [ "$before" != "$after" ] && /etc/init.d/meowx running; then
		log "App" "po0 list changed, reload."
		/etc/init.d/meowx reload
	fi
}

# 每天一次（只在「自动选最快」时挂）：重测各加速地址；原来选中的已经不可达、新选的又不一样时重载，
# 否则只更新缓存、下次启动再用（不为换一个更快的地址打断连接）
ghproxy_cron() {
	if [ "$(ucode -S "$GHPROXY_CLI" cron)" = "reload" ] && service_running_meowx; then
		log "App" "GitHub mirror changed, reload."
		reload
	fi
}
