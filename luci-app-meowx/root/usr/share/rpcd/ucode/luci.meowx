#!/usr/bin/ucode

'use strict';

import { access, popen, readfile, writefile } from 'fs';
import { cursor } from 'uci';
import { get_users, get_groups, get_cgroups, load_profile } from '/etc/meowx/ucode/include.uc';

// 拼进 shell 命令行的参数一律经它：整个值包进单引号，值里的单引号换成 '\''（popen 走 /bin/sh -c）
function shell_quote(value) {
	return "'" + replace(`${value ?? ''}`, "'", "'\\''") + "'";
}

function panel_cmd(args) {
	const process = popen(`/usr/bin/meowx-core panel ${args} 2>/dev/null`);
	if (!process) {
		return { success: false, error: 'meowx-core not found' };
	}
	const output = process.read('all');
	process.close();
	return json(trim(output) || '{}') ?? { success: false, error: 'bad output' };
}

// 登录 / 退出 / 改 po0 之后：重挂白名单上报的定时任务；po0 实际上报的地址变了、服务又跑着就重载（直连规则写在配置里）
function po0_urls() {
	return join('\n', json(readfile('/etc/meowx/po0.json') ?? 'null')?.report_urls ?? []);
}

function panel_sync(urls_before, report) {
	if (po0_urls() != urls_before && system('/etc/init.d/meowx running >/dev/null 2>&1') == 0) {
		system('/etc/init.d/meowx reload >/dev/null 2>&1');
	}
	system('/etc/init.d/meowx panel_cron >/dev/null 2>&1');
	if (report) {
		system('(/usr/bin/meowx-core panel report >/dev/null 2>&1 &)');
	}
}

// 新订阅一律建具名 section（sub_<8 位十六进制>）：匿名 section 的 ID（cfgXXXXXX）按位置算，调整顺序后就变，
// 而在用的配置（subscription:<ID>）与缓存文件（subscriptions/<ID>.yaml）都靠它关联
function new_subscription(uci) {
	let id = 'sub_' + hexenc(readfile('/dev/urandom', 4));
	while (uci.get('meowx', id) != null) {
		id = 'sub_' + hexenc(readfile('/dev/urandom', 4));
	}
	uci.set('meowx', id, 'subscription');
	return id;
}

// 服务上次启动 / 重载 / 切换没成功的原因（init 写在 /var/run/meowx/last_error：「时间戳<TAB>原因」，启动成功时删掉）
function read_last_error() {
	const line = trim(readfile('/var/run/meowx/last_error') ?? '');
	const tab = index(line, '\t');
	if (tab < 0) {
		return { error: null };
	}
	return { time: int(substr(line, 0, tab)), error: substr(line, tab + 1) };
}

function service_running() {
	return system('/etc/init.d/meowx running >/dev/null 2>&1') == 0;
}

// 这个订阅正在更新：init 在下载 → 校验 → 替换缓存期间拿着这把锁
function subscription_busy(section_id) {
	const lock = `/var/run/meowx/subscription.${section_id}.lock`;
	return !!access(lock) && system(['flock', '-n', lock, 'true']) != 0;
}

// 订阅这次更新的结果：success 只代表下载并校验通过、缓存已替换；失败时 error_type = download / invalid / test，error 是具体原因
function subscription_result(section_id) {
	const uci = cursor();
	return {
		success: uci.get('meowx', section_id, 'success') == '1',
		error_type: uci.get('meowx', section_id, 'error_type'),
		error: uci.get('meowx', section_id, 'error')
	};
}

// 订阅地址的主机名（小写）与路径
function url_parts(u) {
	const m = match(u ?? '', /^[A-Za-z][A-Za-z0-9+.-]*:\/\/(\[[^\]]+\]|[^\/:?#]+)(:[0-9]+)?([^?#]*)/);
	return m ? { host: lc(m[1]), path: m[3] || '/' } : null;
}

// 登录后自动导入（规则同客户端 SubAccountStore.autoImportCandidate）：返回导入的订阅名，没导入返回 null
function auto_import(base) {
	const uci = cursor();
	uci.load('meowx');
	const profile = uci.get('meowx', 'config', 'profile') ?? '';
	if (match(profile, /^subscription:/) && uci.get('meowx', substr(profile, 13))) {
		return null;   // 在用别家（或这个主控）的订阅时不替用户换
	}
	const panel_host = url_parts(base)?.host;
	let has_local = false;
	uci.foreach('meowx', 'subscription', (section) => {
		if (url_parts(section.url)?.host == panel_host) {
			has_local = true;
		}
	});
	if (has_local) {
		return null;
	}
	const list = panel_cmd('subscriptions');
	if (!list?.success || length(list.subscriptions ?? []) != 1) {
		return null;   // 多份不替用户选
	}
	const sub = list.subscriptions[0];
	const section_id = new_subscription(uci);
	uci.set('meowx', section_id, 'url', sub.url);
	uci.set('meowx', section_id, 'name', sub.name);
	uci.set('meowx', section_id, 'user_agent', 'meowx');
	uci.set('meowx', section_id, 'prefer', 'remote');
	uci.commit('meowx');
	system(['/etc/init.d/meowx', 'update_subscription', section_id]);
	system(['/etc/init.d/meowx', 'switch_profile', 'subscription:' + section_id]);
	return sub.name;
}

const methods = {
	// 插件自更新（「关于」页）：查 dl.miaomiaowux.com 发布清单里 OpenWrt 版的最新版本号
	check_update: {
		call: function() {
			const process = popen('wget -q -T 15 -O - https://dl.miaomiaowux.com/meowx/latest.json 2>/dev/null');
			if (!process) {
				return { success: false };
			}
			const manifest = json(trim(process.read('all')) || 'null');
			process.close();
			const entry = manifest?.platforms?.openwrt;
			if (!entry?.version) {
				return { success: false };
			}
			return { success: true, latest: entry.version, core: entry.core, released_at: entry.releasedAt };
		}
	},
	// 后台跑一遍一键安装脚本（与 README 的升级方式相同：opkg 装新 ipk 即升级，apk 带 --upgrade）。
	// 先把脚本下载成文件再执行（管道给 ash 时下载失败也会「成功」退出）；用 setsid 脱离 rpcd——升级 luci-app-meowx
	// 会重载 rpcd，不脱离会被一起带走。成败由页面比较升级前后的版本号判断（脚本最后总是打印 success）
	upgrade: {
		call: function() {
			if (access('/var/run/meowx-upgrade.running')) {
				return { success: true, running: true };
			}
			writefile('/var/run/meowx-upgrade.sh', join('\n', [
				'#!/bin/sh',
				'touch /var/run/meowx-upgrade.running',
				'cd /tmp',
				'if wget -q -T 30 -O /tmp/meowx-install.sh https://dl.miaomiaowux.com/meowx/openwrt/install.sh; then',
				'\tash /tmp/meowx-install.sh',
				'else',
				'\techo "download install.sh failed"',
				'fi',
				'rm -f /tmp/meowx-install.sh /var/run/meowx-upgrade.running',
				''
			]));
			// 先标记「升级中」再起进程：页面紧接着轮询时进程可能还没跑起来
			system('mkdir -p /var/run; touch /var/run/meowx-upgrade.running; rm -f /var/log/meowx-upgrade.log; ' +
				'if command -v setsid >/dev/null 2>&1; then setsid sh /var/run/meowx-upgrade.sh >/var/log/meowx-upgrade.log 2>&1 </dev/null & ' +
				'else sh /var/run/meowx-upgrade.sh >/var/log/meowx-upgrade.log 2>&1 </dev/null & fi');
			return { success: true, running: true };
		}
	},
	// 内核目录下的 Web 面板装了没有（「打开面板」前看一眼：新装的插件从没下载过面板，直接打开是 404）。
	// 路径与运行配置一致：<内核目录 /etc/meowx/run>/<external-ui>/<external-ui-name>/index.html
	dashboard_status: {
		args: { ui: 'ui', name: 'name' },
		call: function(req) {
			const ui = req.args?.ui ?? '';
			const name = req.args?.name ?? '';
			if (!ui || match(ui, /\.\./) || match(name, /\.\.|\//)) {
				return { installed: false };
			}
			const base = substr(ui, 0, 1) == '/' ? ui : '/etc/meowx/run/' + ui;
			const dir = name ? base + '/' + name : base;
			return { installed: !!access(dir + '/index.html') };
		}
	},
	// 服务上次启动 / 重载 / 切换没成功的原因（init 写在 /var/run/meowx/last_error：「时间戳<TAB>原因」，启动成功时删掉）
	last_error: {
		call: function() {
			return read_last_error();
		}
	},
	upgrade_status: {
		call: function() {
			const log = readfile('/var/log/meowx-upgrade.log') ?? '';
			return { running: !!access('/var/run/meowx-upgrade.running'), log: substr(log, -4000) };
		}
	},
	version: {
		call: function() {
			let process;
			let app = '';
			if (system('command -v opkg') == 0) {
				process = popen('opkg list-installed luci-app-meowx | cut -d " " -f 3');
				if (process) {
					app = trim(process.read('all'));
					process.close();
				}
			} else if (system('command -v apk') == 0) {
				process = popen('apk list -I luci-app-meowx | cut -d " " -f 1 | cut -d "-" -f 4');
				if (process) {
					app = trim(process.read('all'));
					process.close();
				}
			}
			let core = '';
			process = popen('meowx-core -v | grep Mihomo | cut -d " " -f 3');
			if (process) {
				core = trim(process.read('all'));
				process.close();
			}
			return { app: app, core: core };
		}
	},
	profile: {
		args: { defaults: {} },
		call: function(req) {
			let profile = {};
			const defaults = req.args?.defaults ?? {};
			const filepath = '/etc/meowx/run/config.yaml';
			const tmpFilepath = '/var/run/meowx/profile.json';
			if (access(filepath, 'r')) {
				writefile(tmpFilepath, defaults);
				const command = `yq -M -p yaml -o json eval-all 'select(fi == 0) *? select(fi == 1)' ${tmpFilepath} ${filepath}`;
				const process = popen(command);
				if (process) {
					profile = json(process);
					process.close();
				}
			}
			return profile;
		}
	},
	update_subscription: {
		args: { section_id: 'section_id' },
		call: function(req) {
			const section_id = req.args?.section_id;
			if (!match(section_id ?? '', /^[A-Za-z0-9_]+$/)) {
				return { success: false };
			}
			if (subscription_busy(section_id)) {
				return { success: false, busy: true };
			}
			const rc = system(['/etc/init.d/meowx', 'update_subscription', section_id]);
			const res = subscription_result(section_id);
			res.busy = rc == 3;
			return res;
		}
	},
	// 同客户端：刷新后若正是在用的订阅、服务又在跑，立刻重载生效。
	// 下载成功与套用成功分开报：success = 下载并校验通过（缓存已换）；需要套用时 applied = true / false（false 时运行中的配置保持不动，
	// 原因在 apply_error）；不需要套用（不是在用的订阅、服务没在跑）时没有 applied
	refresh_subscription: {
		args: { section_id: 'section_id' },
		call: function(req) {
			const section_id = req.args?.section_id;
			if (!match(section_id ?? '', /^[A-Za-z0-9_]+$/)) {
				return { success: false };
			}
			// 同一个订阅已经在更新：直接告诉界面，不排队等
			if (subscription_busy(section_id)) {
				return { success: false, busy: true };
			}
			const active = cursor().get('meowx', 'config', 'profile') == 'subscription:' + section_id;
			const rc = system(['/etc/init.d/meowx', 'refresh_subscription', section_id]);
			const res = subscription_result(section_id);
			res.busy = rc == 3;
			if (rc == 2) {
				res.applied = false;
				res.apply_error = read_last_error().error;
			} else if (rc == 0 && active && service_running()) {
				res.applied = true;
			}
			return res;
		}
	},
	// 切换在用的配置（没启用就顺手启用）。服务在跑时新配置不能用就退回原来的选择、运行中的保持不动（kept = true）
	switch_profile: {
		args: { profile: 'profile' },
		call: function(req) {
			const profile = req.args?.profile ?? '';
			if (!match(profile, /^(file:[^\/]+|subscription:[A-Za-z0-9_]+)$/)) {
				return { success: false };
			}
			const running = service_running();
			const rc = system(['/etc/init.d/meowx', 'switch_profile', profile]);
			if (rc == 0) {
				return { success: true };
			}
			return { success: false, kept: rc == 2 && running, error: rc == 2 ? read_last_error().error : null };
		}
	},
	// 只要一个链接就能加订阅：名字等下载后按 profile-title 自动填（同客户端），UA 用官方客户端那份
	add_subscription: {
		args: { url: 'url', name: 'name' },
		call: function(req) {
			const url = trim(req.args?.url ?? '');
			if (!match(url, /^https?:\/\/[^[:space:]]+$/)) {
				return { success: false, error: 'invalid url' };
			}
			const uci = cursor();
			uci.load('meowx');
			const section_id = new_subscription(uci);
			uci.set('meowx', section_id, 'url', url);
			uci.set('meowx', section_id, 'user_agent', 'meowx');
			uci.set('meowx', section_id, 'prefer', 'remote');
			const name = trim(req.args?.name ?? '');
			if (name != '') {
				uci.set('meowx', section_id, 'name', name);
			}
			uci.commit('meowx');
			system(['/etc/init.d/meowx', 'update_subscription', section_id]);
			const res = subscription_result(section_id);
			res.section_id = section_id;
			return res;
		}
	},
	// ---------- 主控账户（登录链接）：实际的加密 RPC 在 meowx-core panel 子命令里 ----------
	panel_status: {
		call: function() {
			return panel_cmd('status');
		}
	},
	// 用主控网页「扫码登录」里复制的登录链接登录；成功后同客户端：当前没在用订阅、本机还没有这个主控的订阅、
	// 账户下恰好一份时自动导入并切过去；立即报一次白名单
	panel_login: {
		args: { link: 'link' },
		call: function(req) {
			const link = trim(req.args?.link ?? '');
			if (!match(link, /^miaomiaowu:\/\/login\?[A-Za-z0-9%._~:\/?&=+-]+$/)) {
				return { success: false, error: 'invalid link' };
			}
			const urls = po0_urls();
			const res = panel_cmd(`login ${shell_quote(link)}`);
			if (!res?.success) {
				return res;
			}
			// 开着 po0 加白：登录后马上取这个账户的 po0 列表（同客户端）
			if (json(readfile('/etc/meowx/po0.json') ?? 'null')?.enabled) {
				panel_cmd('po0 fetch');
			}
			res.imported = auto_import(res.base);
			panel_sync(urls, true);
			return res;
		}
	},
	// 退出登录同客户端：删掉从这个主控导入的订阅（手动加的别家订阅不动）；在用的那份被删了就换到剩下的第一份，
	// 一份都不剩就停掉服务
	panel_logout: {
		call: function() {
			const status = panel_cmd('status');
			const urls = po0_urls();
			const res = panel_cmd('logout');
			const panel_host = url_parts(status?.base)?.host;
			if (!panel_host) {
				panel_sync(urls, false);
				return res;
			}
			const uci = cursor();
			uci.load('meowx');
			const profile = uci.get('meowx', 'config', 'profile') ?? '';
			let active_removed = false;
			const removed = [];
			uci.foreach('meowx', 'subscription', (section) => {
				if (url_parts(section.url)?.host == panel_host) {
					push(removed, section['.name']);
				}
			});
			for (let id in removed) {
				if (profile == 'subscription:' + id) {
					active_removed = true;
				}
				uci.delete('meowx', id);
			}
			let next = null;
			if (active_removed) {
				uci.foreach('meowx', 'subscription', (section) => {
					next ??= 'subscription:' + section['.name'];
				});
				uci.set('meowx', 'config', 'profile', next ?? '');
				if (!next) {
					uci.set('meowx', 'config', 'enabled', '0');
				}
			}
			uci.commit('meowx');
			if (active_removed) {
				system(next ? ['/etc/init.d/meowx', 'restart'] : ['/etc/init.d/meowx', 'stop']);
			}
			panel_sync(active_removed ? po0_urls() : urls, false);
			res.removed = length(removed);
			return res;
		}
	},
	// 用户点刷新时才向主控重取昵称 / 头像与白名单上报地址（同客户端：账户数据不定时拉）
	panel_profile: {
		call: function() {
			const res = panel_cmd('profile');
			panel_cmd('firewall');
			return res;
		}
	},
	panel_subscriptions: {
		call: function() {
			return panel_cmd('subscriptions');
		}
	},
	// po0 加白（同客户端「po0 加白」）：action = status / enable / disable / fetch / add(address, token) / remove(index)。
	// token 完整值只留在路由器上，回给界面的都是脱敏写法
	po0: {
		args: { action: 'action', address: 'address', token: 'token', index: 0 },
		call: function(req) {
			const action = req.args?.action ?? 'status';
			let args;
			if (action == 'add') {
				const address = trim(req.args?.address ?? '');
				const token = trim(req.args?.token ?? '');
				// 只放行地址里可能出现的字符（规范化在 meowx-core 里做）；POSIX 方括号里 ] 要放第一个
				if (!match(address, /^[][A-Za-z0-9.:\/_-]{1,255}$/)) {
					return { success: false, error: 'invalid address' };
				}
				if (!match(token, /^pgnfw_[A-Za-z0-9_-]{4,200}(@[0-9]{1,2})?$/)) {
					return { success: false, error: 'invalid token' };
				}
				args = `po0 add ${shell_quote(address)} ${shell_quote(token)}`;
			} else if (action == 'remove') {
				args = `po0 remove ${int(req.args?.index ?? -1)}`;
			} else if (index([ 'status', 'enable', 'disable', 'fetch' ], action) >= 0) {
				args = `po0 ${action}`;
			} else {
				return { success: false, error: 'invalid action' };
			}
			const urls = po0_urls();
			const res = panel_cmd(args);
			if (action != 'status' && res?.success) {
				panel_sync(urls, action != 'disable' && action != 'remove');
			}
			return res;
		}
	},
	api: {
		args: { method: 'method', path: 'path', query: 'query', body: 'body' },
		call: function(req) {
			let result = {};

			const method = req.args?.method;
			const path = req.args?.path;
			const query = req.args?.query;
			const body = req.args?.body;

			const profile = load_profile();
			const api_listen = profile['external-controller'];
			const api_tls_listen = profile['external-controller-tls'];
			const api_secret = profile['secret'];
			if (!api_listen && !api_tls_listen) {
				return result;
			}

			const protocol = api_tls_listen ? 'https' : 'http';

			const url = (api_tls_listen ?? api_listen) + path;

			// 方法只放行 HTTP 动词，路径必须以 / 开头；其余参数（含节点名的路径、body、secret）都经 shell_quote，
			// 以前直接包在单引号里，值里带单引号就能跳出来执行任意命令。没传 query / body 时不带这两个参数
			// （以前会拼成字面量 'null'：请求地址多出 ?null、GET 也带上 body）
			if (!match(method ?? '', /^(GET|POST|PUT|PATCH|DELETE)$/) || substr(path ?? '', 0, 1) != '/') {
				return result;
			}
			let command = `curl --proto-default ${shell_quote(protocol)} --insecure --request ${shell_quote(method)}`;
			if (api_secret != null) {
				command += ` --oauth2-bearer ${shell_quote(api_secret)}`;
			}
			if (query != null) {
				command += ` --url-query ${shell_quote(query)}`;
			}
			if (body != null) {
				command += ` --data ${shell_quote(body)}`;
			}
			command += ` ${shell_quote(url)}`;
			const process = popen(command);
			if (process) {
				const output = trim(process.read('all'));
				process.close();
				// 内核对 PUT 等回 204 空包、出错时可能回纯文本：不是 JSON 也别让整个 RPC 报错
				try {
					result = json(output || '{}');
				} catch (e) {
					result = { message: output };
				}
			}

			return result;
		}
	},
	get_identifiers: {
		call: function() {
			const users = filter(get_users(), (x) => x != '');
			const groups = filter(get_groups(), (x) => x != '');
			const cgroups = filter(get_cgroups(), (x) => x != '' && index(x, 'services/meowx') < 0);
			return { users: users, groups: groups, cgroups: cgroups };
		}
	},
	debug: {
		call: function() {
			const success = system('/etc/meowx/scripts/debug.sh > /var/log/meowx/debug.log') == 0;
			return { success: success };
		}
	}
};

return { 'luci.meowx': methods };